{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "paths": {
      "buy-me-a-coffee-cta": ["./src/index.ts"],
      "buy-me-a-coffee-cta/style.css": ["./src/styles.css"]
    }
  },
  "include": ["demo/**/*.ts", "demo/**/*.d.ts"]
}
