{
	"name": "buy-me-a-coffee-cta",
	"version": "0.2.0",
	"description": "Scroll-driven Buy Me a Coffee floating button — vanilla JS, zero dependencies",
	"license": "MIT",
	"author": "Salman Amakran",
	"type": "module",
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=20"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./style.css": "./dist/style.css"
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "tsup && node scripts/copy-styles.mjs",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"demo": "vite",
		"demo:build": "vite build",
		"demo:preview": "vite preview --config vite.config.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.demo.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"smoke-test": "node scripts/smoke-test.mjs",
		"prepublishOnly": "pnpm build && pnpm test && pnpm smoke-test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@vitest/coverage-v8": "^3.2.4",
		"eslint": "^10.4.0",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.60.0",
		"vite": "^6.3.5",
		"vitest": "^3.2.1"
	},
	"keywords": [
		"buy-me-a-coffee",
		"bmc",
		"donation",
		"cta",
		"scroll",
		"floating-button"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/getkode/buy-me-a-coffee-cta.git"
	},
	"bugs": {
		"url": "https://github.com/getkode/buy-me-a-coffee-cta/issues"
	},
	"homepage": "https://getkode.github.io/buy-me-a-coffee-cta/"
}
